rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoUrl', 'createdAt'])
        && data.uid == uid
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1024));
    }

    function isValidFavorite(data, uid) {
      return data.keys().hasAll(['userUid', 'trackId'])
        && data.keys().hasOnly(['userUid', 'trackId', 'createdAt'])
        && data.userUid == uid
        && data.userUid is string && data.userUid.size() <= 128
        && data.trackId is string && data.trackId.size() <= 128 && data.trackId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPlaylist(data, uid) {
      return data.keys().hasAll(['id', 'userUid', 'title'])
        && data.keys().hasOnly(['id', 'userUid', 'title', 'description', 'createdAt'])
        && data.userUid == uid
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow listing user directories

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(request.resource.data, userId);

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(request.resource.data, userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoUrl', 'createdAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // User favorites subcollection
      match /favorites/{trackId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(trackId)
          && isValidFavorite(request.resource.data, userId)
          && request.resource.data.trackId == trackId;

        allow update: if false; // Favorites are immutable: create or delete

        allow delete: if isOwner(userId) && isValidId(trackId);
      }

      // User playlists subcollection
      match /playlists/{playlistId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(playlistId)
          && isValidPlaylist(request.resource.data, userId)
          && request.resource.data.id == playlistId;

        allow update: if isOwner(userId)
          && isValidId(playlistId)
          && isValidPlaylist(request.resource.data, userId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.userUid == resource.data.userUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description']);

        allow delete: if isOwner(userId) && isValidId(playlistId);
      }
    }

    match /trending_hits/{hitId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
