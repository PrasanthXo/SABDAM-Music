# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Used server-side to fetch songs, artists, and music videos from YouTube Data API v3.
YOUTUBE_API_KEY=""

# Google OAuth Client Configuration (for Sign in with Google / Gmail)
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook Login Configuration (for Sign in with Facebook)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Spotify OAuth Configuration (for Syncing Playlists)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Email OTP Delivery Configuration (Nodemailer / SMTP / Resend)
# Option A: Standard SMTP (Brevo, SendGrid, Mailgun, Amazon SES, or custom mail server)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SABDHAM Music <noreply@sabdham.com>"

# Option B: Gmail App Password
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Option C: Resend API Key
RESEND_API_KEY=""
